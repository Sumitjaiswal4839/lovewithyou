APP_NAME=Age Estimation API
APP_VERSION=2.0.0
ENVIRONMENT=production

MAX_IMAGE_SIZE_MB=8
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=12000000

MIN_FACE_FRACTION=0.08
MAX_FACE_FRACTION=0.85
MIN_SHARPNESS=80
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=215
MAX_YAW_DEGREES=25
MAX_PITCH_DEGREES=25
MAX_ROLL_DEGREES=20
MIN_DETECTOR_CONFIDENCE=0.90

DETECTOR_BACKEND=retinaface
AGE_MODEL_NAME=Age
CALIBRATION_PATH=models/calibration.json

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

AUTH_REQUIRED=false
AUTH_SECRET=

REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
